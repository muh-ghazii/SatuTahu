# Salin file ini menjadi .env.local lalu isi nilainya.
# Nilai ada di Supabase Dashboard → Project Settings → API Keys (dan Data API untuk URL).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Publishable key (diawali sb_publishable_...). Aman berada di browser karena data dilindungi Row Level Security.
# Proyek lama yang hanya punya "anon key" boleh mengisi NEXT_PUBLIC_SUPABASE_ANON_KEY sebagai gantinya.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Domain situs (untuk metadata Open Graph). Contoh: https://satutahu.netlify.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# JANGAN pernah menaruh service_role / secret key di variabel NEXT_PUBLIC_*.
